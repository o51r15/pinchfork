<div class="flex h-screen overflow-hidden">
  <% current_path =
    if assigns[:conn], do: Phoenix.Controller.current_path(assigns.conn), else: assigns[:current_path] || "" %>
  <.sidebar current_path={current_path} />

  <div class="relative flex flex-1 flex-col overflow-y-auto overflow-x-hidden">
    <.header params={if assigns[:conn], do: assigns.conn.params, else: %{}} />
    <main>
      <div class="mx-auto max-w-screen-2xl p-4 md:p-6 2xl:p-10">
        <%!-- assigns[:flash]: error pages (e.g. an invalid CSRF token) can render this layout
             before the flash was fetched; @flash would raise KeyError and turn a 403 into a 500. --%>
        <.flash_group flash={assigns[:flash] || %{}} />
        {@inner_content}
      </div>
    </main>
  </div>
</div>
