<div
  x-cloak
  x-show="sidebarVisible"
  x-transition.opacity
  class="fixed inset-0 z-9998 bg-black-2/60 lg:hidden"
  @click="sidebarVisible = false"
  aria-hidden="true"
>
</div>
<aside
  x-bind:class="sidebarVisible ? 'translate-x-0' : '-translate-x-full'"
  class={[
    "-translate-x-full fixed left-0 top-0 z-9999 flex h-screen w-60 flex-col overflow-y-hidden",
    "border-r border-line bg-surface duration-200 ease-out lg:static lg:translate-x-0"
  ]}
  aria-label="Main navigation"
>
  <div class="flex items-center justify-between gap-2 px-5 pt-5 pb-6">
    <.link href={~p"/sources"} class="flex items-center gap-2.5 text-fg hover:text-fg">
      <.brand_mark class="h-7 w-7" />
      <span class="text-lg font-bold tracking-tight">Pinchfork</span>
    </.link>
    <button
      type="button"
      class="rounded-lg p-1.5 text-muted hover:bg-surface-2 hover:text-fg lg:hidden"
      @click.stop="sidebarVisible = false"
      aria-label="Close menu"
    >
      <.icon name="hero-x-mark" class="h-5 w-5" />
    </button>
  </div>

  <nav class="no-scrollbar flex-1 overflow-y-auto px-3 pb-6">
    <ul class="flex flex-col gap-1">
      <.nav_item icon="hero-tv" text="Sources" href={~p"/sources"} current_path={@current_path} match="/sources" />
      <.nav_item
        :if={@discovery_enabled}
        icon="hero-light-bulb"
        text="Discovery"
        href={~p"/discovery"}
        current_path={@current_path}
        match="/discovery"
      />
      <.nav_item
        icon="hero-queue-list"
        text="Activity"
        href={~p"/activity"}
        current_path={@current_path}
        match="/activity"
        badge={@running_count}
      />
      <.nav_group
        icon="hero-cog-6-tooth"
        text="Settings"
        current_path={@current_path}
        matches={["/settings", "/media_profiles"]}
      >
        <:item text="Media Profiles" href={~p"/media_profiles"} match="/media_profiles" />
        <:item text="YouTube Access" href={~p"/settings/youtube"} match="/settings/youtube" />
        <:item text="General" href={~p"/settings"} match="/settings" exact />
      </.nav_group>
      <.nav_group icon="hero-server-stack" text="System" current_path={@current_path} matches={["/system", "/stats"]}>
        <:item text="Status" href={~p"/system/status"} match="/system/status" />
        <:item text="Stats" href={~p"/stats"} match="/stats" />
        <:item text="Backup" href={~p"/system/backup"} match="/system/backup" />
        <:item text="Updates" href={~p"/system/updates"} match="/system/updates" />
      </.nav_group>
    </ul>
  </nav>

  <div class="border-t border-line px-5 py-4 text-xs text-muted">
    <div class="flex items-center justify-between gap-2">
      <span class="font-mono tabular">v{Application.spec(:pinchflat)[:vsn]}</span>
      <.link href="https://github.com/o51r15/pinchfork/wiki" target="_blank" class="hover:text-fg">Docs</.link>
    </div>
    <div class="mt-1">
      Based on
      <.link
        href="https://github.com/kieraneglin/pinchflat"
        target="_blank"
        class="hover:text-fg underline-offset-2 hover:underline"
      >
        Pinchflat
      </.link>
    </div>
  </div>
</aside>
