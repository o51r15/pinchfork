<.page_header
  title="Media Profiles"
  description="A profile decides video quality, subtitles, artwork and how files are named. Every source uses one."
>
  <:actions>
    <.link href={~p"/media_profiles/new"}>
      <.button color="bg-primary">
        <.icon name="hero-plus" class="mr-1.5 h-4 w-4" /> New profile
      </.button>
    </.link>
  </:actions>
</.page_header>

<.card :if={@media_profiles == []}>
  <.empty_state
    icon="hero-adjustments-horizontal"
    title="No media profiles yet"
    description="Create one to choose quality and file naming, then pick it when you add a source."
  />
</.card>

<div :if={@media_profiles != []} class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <.link
    :for={profile <- @media_profiles}
    href={~p"/media_profiles/#{profile.id}"}
    id={"media-profile-#{profile.id}"}
    class="pf-card flex flex-col gap-3 p-5 transition-colors hover:border-accent/60"
  >
    <div class="flex items-start justify-between gap-3">
      <h2 class="min-w-0 truncate text-base font-semibold text-fg">{profile.name}</h2>
      <.status_chip kind={if profile.source_count > 0, do: :accent, else: :neutral} class="shrink-0">
        {profile.source_count} {if profile.source_count == 1, do: "source", else: "sources"}
      </.status_chip>
    </div>
    <dl class="grid grid-cols-2 gap-3 text-[13px]">
      <div>
        <dt class="text-muted">Quality</dt>
        <dd class="mt-0.5 font-medium text-fg">
          {if profile.preferred_resolution == :audio, do: "Audio only", else: profile.preferred_resolution}
        </dd>
      </div>
      <div>
        <dt class="text-muted">Container</dt>
        <dd class="mt-0.5 font-medium text-fg">{profile.media_container || "Default"}</dd>
      </div>
    </dl>
    <p class="truncate font-mono text-xs text-muted" title={profile.output_path_template}>
      {profile.output_path_template}
    </p>
  </.link>
</div>
