<.form :let={f} for={%{"username" => @username}} as={:user} action={~p"/login"} class="pf-card flex flex-col gap-1 p-7">
  <h1 class="text-lg font-semibold text-fg">Sign in</h1>

  <div
    :if={@error}
    role="alert"
    class="mt-3 flex items-start gap-2 rounded-lg border border-bad/40 bg-bad/10 px-3 py-2.5 text-sm text-fg"
  >
    <.icon name="hero-exclamation-triangle" class="mt-0.5 h-4 w-4 shrink-0 text-bad" />
    <span>{@error}</span>
  </div>

  <.input field={f[:username]} type="text" label="Username" autocomplete="username" required autofocus />
  <.input field={f[:password]} type="password" label="Password" value="" autocomplete="current-password" required />

  <label class="mt-5 flex cursor-pointer items-center gap-2.5 text-sm text-muted">
    <input type="hidden" name="user[remember_me]" value="false" />
    <input
      type="checkbox"
      name="user[remember_me]"
      value="true"
      class="h-4 w-4 rounded border-line bg-surface-2 text-accent focus:ring-0 focus:ring-offset-0"
    /> Keep me signed in for 60 days
  </label>

  <.button class="mt-6 w-full">Sign in</.button>

  <p class="mt-4 text-[13px] leading-5 text-muted">
    Forgot your password? On the server, run
    <code class="break-all rounded bg-surface-2 px-1 font-mono text-xs text-fg">
      docker exec -it pinchfork /app/bin/reset_password &lt;username&gt;
    </code>
  </p>
</.form>
