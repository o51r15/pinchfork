<div class="mx-auto max-w-4xl">
  <.link href={~p"/sources/#{@source}"} class="mb-3 inline-flex items-center gap-1.5 text-sm text-muted hover:text-fg">
    <.icon name="hero-arrow-left" class="h-4 w-4" /> {@source.custom_name}
  </.link>
  <.page_header
    title="Artwork and description"
    description="How this source appears in your media center. Pinchfork fills these in from YouTube; lock anything you've changed so a refresh doesn't overwrite it."
  />

  <div x-data={"{ tab: '#{@tab}' }"}>
    <nav class="-mb-px mb-5 flex gap-6 border-b border-line" role="tablist">
      <button
        :for={{id, label} <- [{"general", "Name and description"}, {"poster", "Poster"}]}
        type="button"
        role="tab"
        x-on:click={"tab = '#{id}'; history.replaceState(null, '', '?tab=#{id}')"}
        x-bind:aria-selected={"tab === '#{id}'"}
        x-bind:class={"tab === '#{id}' ? 'border-accent text-fg' : 'border-transparent text-muted hover:text-fg'"}
        class="border-b-2 py-3 text-sm font-semibold transition-colors"
      >
        {label}
      </button>
    </nav>

    <%!-- Name and description --%>
    <div x-show="tab === 'general'" x-cloak={@tab != "general"} role="tabpanel">
      <.form :let={f} for={@changeset} action={~p"/sources/#{@source}/edit_metadata"} method="post" id="metadata-form">
        <.card>
          <div class="px-5 pt-4 pb-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <label for="metadata_name" class="text-sm font-medium text-fg">Name</label>
              <.lock_switch field={f[:custom_name_locked]} />
            </div>
            <input
              type="text"
              id="metadata_name"
              name={f[:custom_name].name}
              value={f[:custom_name].value}
              class="pf-input mt-1.5"
            />
            <p :for={msg <- Enum.map(f[:custom_name].errors, &translate_error/1)} class="mt-1.5 text-[13px] text-bad">{msg}</p>
          </div>
          <div class="border-t border-line px-5 pt-4 pb-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <label for="metadata_description" class="text-sm font-medium text-fg">Description</label>
              <.lock_switch field={f[:description_locked]} />
            </div>
            <textarea
              id="metadata_description"
              name={f[:description].name}
              rows="9"
              class="pf-input mt-1.5 h-auto py-2.5 leading-6"
            >{f[:description].value}</textarea>
            <p class="mt-1.5 text-xs text-muted">Shown in Plex, Jellyfin and podcast apps.</p>
          </div>
        </.card>
        <div class="mt-5 flex justify-end gap-2">
          <.link
            href={~p"/sources/#{@source}"}
            class="inline-flex h-10 items-center rounded-lg px-4 text-sm font-semibold text-muted hover:text-fg"
          >
            Cancel
          </.link>
          <button
            type="submit"
            class="inline-flex h-10 items-center rounded-lg bg-accent px-5 text-sm font-semibold text-onaccent hover:opacity-90"
          >
            Save
          </button>
        </div>
      </.form>
    </div>

    <%!-- Poster --%>
    <div x-show="tab === 'poster'" x-cloak={@tab != "poster"} role="tabpanel">
      <.card>
        <div class="flex flex-wrap gap-6 p-5">
          <div class="w-40 shrink-0 overflow-hidden rounded-lg border border-line bg-surface-2 shadow-lg" style="aspect-ratio: 2/3;">
            <img src={~p"/sources/#{@source.id}/poster"} alt="Current poster" class="h-full w-full object-cover" />
          </div>
          <div class="min-w-[240px] flex-1">
            <h2 class="text-base font-semibold text-fg">Current poster</h2>
            <div class="mt-2">
              <.status_chip :if={@source.custom_poster_filepath} kind={:accent}>Your own image</.status_chip>
              <.status_chip :if={!@source.custom_poster_filepath}>From YouTube</.status_chip>
            </div>
            <p class="mt-2 text-[13px] leading-5 text-muted">
              <%= if @source.custom_poster_filepath do %>
                Refreshing artwork from YouTube won't replace it. Remove it to go back to YouTube's image.
              <% else %>
                Taken from the channel's YouTube artwork. Upload your own or use a link to replace it.
              <% end %>
            </p>
            <.link
              :if={@source.custom_poster_filepath}
              href={~p"/sources/#{@source}/custom_poster"}
              method="delete"
              data-confirm="Remove your poster and go back to the one from YouTube?"
              class="mt-4 inline-flex h-9 items-center gap-1.5 rounded-lg border border-bad/40 px-3.5 text-sm font-semibold text-bad hover:bg-bad/10"
            >
              <.icon name="hero-trash-mini" class="h-4 w-4" /> Remove my poster
            </.link>
          </div>
        </div>

        <div class="grid grid-cols-1 border-t border-line md:grid-cols-2">
          <.form for={%{}} action={~p"/sources/#{@source}/custom_poster"} method="post" multipart={true} class="p-5" id="poster-upload-form">
            <h3 class="text-sm font-semibold text-fg">Upload an image</h3>
            <p class="mt-1 text-[13px] text-muted">JPG, PNG or WebP, up to 10 MB. Tall (2:3) images look best.</p>
            <input
              type="file"
              name="poster[upload]"
              accept="image/jpeg,image/png,image/webp"
              required
              class="mt-3 block w-full text-sm text-muted file:mr-3 file:h-9 file:cursor-pointer file:rounded-lg file:border file:border-line file:bg-surface-2 file:px-3 file:text-sm file:font-semibold file:text-fg hover:file:bg-surface-3"
            />
            <button type="submit" class="mt-3 inline-flex h-9 items-center gap-1.5 rounded-lg bg-accent px-4 text-sm font-semibold text-onaccent hover:opacity-90">
              <.icon name="hero-arrow-up-tray-mini" class="h-4 w-4" /> Upload
            </button>
          </.form>

          <.form for={%{}} action={~p"/sources/#{@source}/custom_poster"} method="post" class="border-t border-line p-5 md:border-t-0 md:border-l" id="poster-url-form">
            <h3 class="text-sm font-semibold text-fg">Use an image link</h3>
            <p class="mt-1 text-[13px] text-muted">Pinchfork downloads the image and keeps its own copy.</p>
            <input
              type="url"
              name="poster[url]"
              placeholder="https://…"
              required
              class="pf-input mt-3 font-mono text-sm"
            />
            <button type="submit" class="mt-3 inline-flex h-9 items-center gap-1.5 rounded-lg border border-line px-4 text-sm font-semibold text-fg hover:bg-surface-2">
              <.icon name="hero-link-mini" class="h-4 w-4" /> Use this image
            </button>
          </.form>
        </div>
      </.card>
    </div>
  </div>
</div>
