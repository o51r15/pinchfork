<.link href={~p"/sources"} class="mb-3 inline-flex items-center gap-1.5 text-sm text-muted hover:text-fg">
  <.icon name="hero-arrow-left" class="h-4 w-4" /> Sources
</.link>

<%!-- Header: fanart banner, poster, title and the main actions --%>
<section class="pf-card overflow-hidden" id="source-header">
  <div class="relative h-32 bg-surface-2 md:h-44">
    <img src={~p"/sources/#{@source.id}/fanart"} alt="" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/50 to-transparent"></div>
  </div>
  <div class="relative -mt-14 flex flex-wrap items-end gap-x-5 gap-y-4 px-5 pb-5">
    <div
      class="w-20 shrink-0 overflow-hidden rounded-lg border border-line bg-surface-2 shadow-lg md:w-24"
      style="aspect-ratio: 2/3;"
    >
      <img src={~p"/sources/#{@source.id}/poster"} alt="" class="h-full w-full object-cover" />
    </div>
    <div class="min-w-0 flex-1 pb-0.5">
      <h1 class="truncate text-2xl font-semibold tracking-tight text-fg">{@source.custom_name}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-1.5">
        <.status_chip>{if @source.collection_type == :playlist, do: "Playlist", else: "Channel"}</.status_chip>
        <.link
          href={~p"/media_profiles/#{@source.media_profile_id}"}
          class="pf-chip bg-surface-2 text-muted hover:text-fg"
        >
          {@source.media_profile.name}
        </.link>
        <.status_chip :if={@source.download_media} kind={:ok}>Monitored</.status_chip>
        <.status_chip :if={!@source.download_media} kind={:warn}>Unmonitored</.status_chip>
        <.status_chip :if={@source.fast_index} kind={:accent}>Fast Indexing</.status_chip>
        <span class="ml-1 text-xs text-muted">
          {if @source.last_indexed_at,
            do: "Last full scan #{time_ago(@source.last_indexed_at)}",
            else: "Not scanned yet"}
        </span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 pb-0.5" id="source-actions">
      <.link
        href={~p"/sources/#{@source}/edit"}
        class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-accent px-3.5 text-sm font-semibold text-onaccent hover:opacity-90"
      >
        <.icon name="hero-pencil-square-mini" class="h-4 w-4" /> Edit
      </.link>
      <.link
        href={~p"/sources/#{@source}/force_index"}
        method="post"
        data-confirm="Scan the whole channel or playlist for videos now?"
        class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-line px-3.5 text-sm font-semibold text-fg hover:bg-surface-2"
      >
        <.icon name="hero-arrow-path-mini" class="h-4 w-4" /> Check for new videos
      </.link>
      <.link
        :if={@source.download_media and @counts.pending > 0}
        href={~p"/sources/#{@source}/force_download_pending"}
        method="post"
        data-confirm={"Start downloading the #{@counts.pending} pending videos now?"}
        class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-line px-3.5 text-sm font-semibold text-fg hover:bg-surface-2"
      >
        <.icon name="hero-arrow-down-tray-mini" class="h-4 w-4" /> Download {@counts.pending} pending
      </.link>

      <div
        class="relative"
        x-data="{ open: false }"
        x-on:click.outside="open = false"
        x-on:keydown.escape="open = false"
      >
        <button
          type="button"
          class="inline-flex h-9 items-center gap-1 rounded-lg border border-line px-3 text-sm font-semibold text-fg hover:bg-surface-2"
          x-on:click="open = !open"
          x-bind:aria-expanded="open"
          aria-haspopup="menu"
        >
          More <.icon name="hero-chevron-down-mini" class="h-4 w-4" />
        </button>
        <div
          x-show="open"
          x-cloak
          x-transition.origin.top.right
          role="menu"
          class="absolute right-0 z-50 mt-2 w-64 rounded-xl border border-line bg-surface p-1.5 shadow-xl"
        >
          <.link href={~p"/sources/#{@source}/edit_metadata"} role="menuitem" class={menu_item_class()}>
            <.icon name="hero-photo-mini" class="h-4 w-4 text-muted" /> Edit artwork and description
          </.link>
          <.link
            href={~p"/sources/#{@source}/force_metadata_refresh"}
            method="post"
            data-confirm="Fetch this source's artwork and description from YouTube again?"
            role="menuitem"
            class={menu_item_class()}
          >
            <.icon name="hero-arrow-path-rounded-square-mini" class="h-4 w-4 text-muted" /> Refresh artwork from YouTube
          </.link>
          <.link
            href={~p"/sources/#{@source}/sync_files_on_disk"}
            method="post"
            data-confirm="Check which downloaded files are still on disk? Missing ones are marked as not downloaded."
            role="menuitem"
            class={menu_item_class()}
          >
            <.icon name="hero-folder-open-mini" class="h-4 w-4 text-muted" /> Check files on disk
          </.link>
          <.link
            :if={@source.download_media}
            href={~p"/sources/#{@source}/force_redownload"}
            method="post"
            data-confirm="Download every already-downloaded video again? This can take a long time."
            role="menuitem"
            class={menu_item_class()}
          >
            <.icon name="hero-arrow-down-on-square-stack-mini" class="h-4 w-4 text-muted" /> Download everything again
          </.link>
          <div class="my-1 h-px bg-line"></div>
          <button
            type="button"
            role="menuitem"
            class={[menu_item_class(), "w-full"]}
            x-data="{ copied: false }"
            x-on:click={"navigator.clipboard.writeText(#{Jason.encode!(rss_feed_url(@conn, @source))}).then(() => { copied = true; setTimeout(() => copied = false, 2000) })"}
          >
            <.icon name="hero-rss-mini" class="h-4 w-4 text-muted" />
            <span x-text="copied ? 'Copied' : 'Copy podcast feed link'">Copy podcast feed link</span>
          </button>
          <button
            type="button"
            role="menuitem"
            class={[menu_item_class(), "w-full"]}
            x-data="{ copied: false }"
            x-on:click={"navigator.clipboard.writeText(#{Jason.encode!(Jason.Formatter.pretty_print(Phoenix.json_library().encode!(@source)))}).then(() => { copied = true; setTimeout(() => copied = false, 2000) })"}
          >
            <.icon name="hero-code-bracket-mini" class="h-4 w-4 text-muted" />
            <span x-text="copied ? 'Copied' : 'Copy settings as JSON'">Copy settings as JSON</span>
          </button>
          <.link href={~p"/sources/new?template_id=#{@source.id}"} role="menuitem" class={menu_item_class()}>
            <.icon name="hero-document-duplicate-mini" class="h-4 w-4 text-muted" /> Add a source with these settings
          </.link>
        </div>
      </div>
    </div>
  </div>
</section>

<%!-- Counts --%>
<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" id="source-counts">
  <.count_card label="Videos" value={@counts.total} help="Found on YouTube" />
  <.count_card label="Downloaded" value={@counts.downloaded} help="On disk" class="text-ok" />
  <.count_card
    label="Pending"
    value={@counts.pending}
    help="Waiting to download"
    class={if @counts.pending > 0, do: "text-info", else: nil}
  />
  <.count_card
    label="Failed"
    value={@counts.failed}
    help="Couldn't be downloaded"
    class={if @counts.failed > 0, do: "text-bad", else: nil}
  />
  <.count_card label="Skipped" value={@counts.skipped} help="Left out by your filters and settings" />
  <.count_card label="Turned off" value={@counts.prevented} help="Switched off by hand or a script" />
</div>

<%!-- Episodes, grouped by year --%>
<div class="mt-6">
  {live_render(
    @conn,
    PinchflatWeb.Sources.YearGroupLive,
    session: %{"source_id" => @source.id}
  )}
</div>

<%!-- Background jobs for this source --%>
<section class="pf-card mt-6" x-data={"{ open: #{@pending_tasks != []} }"} id="source-jobs">
  <button type="button" class="flex w-full items-center justify-between px-5 py-3.5 text-left" x-on:click="open = !open">
    <span class="flex items-center gap-2 text-base font-semibold text-fg">
      Background jobs
      <.status_chip :if={@pending_tasks != []} kind={:accent}>{length(@pending_tasks)}</.status_chip>
    </span>
    <.icon name="hero-chevron-down" class="h-4 w-4 text-muted transition-transform" x-bind:class="open && 'rotate-180'" />
  </button>
  <div x-show="open" x-cloak>
    <p :if={@pending_tasks == []} class="border-t border-line px-5 py-4 text-sm text-muted">
      Nothing running or queued for this source.
    </p>
    <table :if={@pending_tasks != []} class="w-full text-sm">
      <thead>
        <tr class="border-t border-line text-left text-xs font-medium uppercase tracking-wide text-muted">
          <th class="px-5 py-2 font-medium">Job</th>
          <th class="px-3 py-2 font-medium">State</th>
          <th class="px-5 py-2 font-medium">Scheduled</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={task <- @pending_tasks} class="border-t border-line">
          <td class="px-5 py-2.5 text-fg">{job_label(task.job.worker)}</td>
          <td class="px-3 py-2.5">
            <.status_chip kind={job_state_kind(task.job.state)}>{job_state_label(task.job.state)}</.status_chip>
          </td>
          <td class="px-5 py-2.5 text-muted"><.datetime_in_zone datetime={task.job.scheduled_at} /></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
