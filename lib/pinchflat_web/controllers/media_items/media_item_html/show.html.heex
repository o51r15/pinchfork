<.link
  href={~p"/sources/#{@media_item.source_id}"}
  class="mb-3 inline-flex items-center gap-1.5 text-sm text-muted hover:text-fg"
>
  <.icon name="hero-arrow-left" class="h-4 w-4" /> {@media_item.source.custom_name}
</.link>

<%!-- Header. Not overflow-hidden: that would clip the More menu. --%>
<section class="pf-card relative z-20 flex flex-col gap-5 p-5 sm:flex-row" id="media-header">
  <div
    :if={!media_file_exists?(@media_item)}
    class="flex aspect-video w-full shrink-0 items-center justify-center overflow-hidden rounded-lg border border-line bg-surface-2 sm:w-56"
  >
    <img
      :if={thumbnail_exists?(@media_item)}
      src={~p"/media/#{@media_item.uuid}/episode_image"}
      alt=""
      class="h-full w-full object-cover"
    />
    <.icon :if={!thumbnail_exists?(@media_item)} name="hero-film" class="h-8 w-8 text-muted" />
  </div>

  <div class="flex min-w-0 flex-1 flex-col gap-3">
    <h1 class="text-xl font-semibold leading-snug tracking-tight text-fg">{@media_item.title}</h1>
    <div class="flex flex-wrap items-center gap-1.5 text-xs text-muted" id="media-status">
      <.status_chip kind={elem(status_badge(@status), 1)}>{elem(status_badge(@status), 0)}</.status_chip>
      <.status_chip :if={@media_item.short_form_content}>Short</.status_chip>
      <.status_chip :if={@media_item.livestream}>Livestream</.status_chip>
      <span :if={@media_item.uploaded_at} class="ml-1">
        Uploaded {Calendar.strftime(@media_item.uploaded_at, "%b %-d, %Y")}
      </span>
      <span :if={format_duration(@media_item.duration_seconds)}>· {format_duration(@media_item.duration_seconds)}</span>
      <span :if={human_size(@media_item.media_size_bytes)}>· {human_size(@media_item.media_size_bytes)}</span>
    </div>

    <div class="mt-auto flex flex-wrap items-center gap-2" id="media-actions">
      <.link
        href={~p"/sources/#{@media_item.source_id}/media/#{@media_item}/force_download"}
        method="post"
        data-confirm={
          if @media_item.media_filepath,
            do: "Download this video again? The new file replaces the old one.",
            else: "Download this video now, even if the download rules would skip it?"
        }
        class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-accent px-3.5 text-sm font-semibold text-onaccent hover:opacity-90"
      >
        <.icon name="hero-arrow-down-tray-mini" class="h-4 w-4" />
        {if @media_item.media_filepath, do: "Download again", else: "Download now"}
      </.link>
      <.link
        :if={URI.parse(@media_item.original_url).scheme in ["http", "https"]}
        href={@media_item.original_url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-line px-3.5 text-sm font-semibold text-fg hover:bg-surface-2"
      >
        <.icon name="hero-arrow-top-right-on-square-mini" class="h-4 w-4" /> Watch on YouTube
      </.link>

      <div
        class="relative"
        x-data="{ open: false }"
        x-on:click.outside="open = false"
        x-on:keydown.escape="open = false"
      >
        <button
          type="button"
          class="inline-flex h-9 items-center gap-1 rounded-lg border border-line px-3 text-sm font-semibold text-fg hover:bg-surface-2"
          x-on:click="open = !open"
          x-bind:aria-expanded="open"
          aria-haspopup="menu"
          id="media-more"
        >
          More <.icon name="hero-chevron-down-mini" class="h-4 w-4" />
        </button>
        <div
          x-show="open"
          x-cloak
          x-transition.origin.top.left
          role="menu"
          class="absolute left-0 z-50 mt-2 w-72 rounded-xl border border-line bg-surface p-1.5 shadow-xl"
        >
          <.link
            :if={media_file_exists?(@media_item)}
            href={stream_path(@media_item)}
            target="_blank"
            role="menuitem"
            class={menu_item_class()}
          >
            <.icon name="hero-play-mini" class="h-4 w-4 text-muted" /> Open the file in a new tab
          </.link>
          <button
            type="button"
            role="menuitem"
            class={[menu_item_class(), "w-full"]}
            x-data="{ copied: false }"
            x-on:click={"navigator.clipboard.writeText(#{Jason.encode!(Jason.Formatter.pretty_print(Phoenix.json_library().encode!(@media_item)))}).then(() => { copied = true; setTimeout(() => copied = false, 2000) })"}
          >
            <.icon name="hero-code-bracket-mini" class="h-4 w-4 text-muted" />
            <span x-text="copied ? 'Copied' : 'Copy details as JSON'">Copy details as JSON</span>
          </button>
          <%= if @media_item.media_filepath do %>
            <div class="my-1 h-px bg-line"></div>
            <.link
              href={~p"/sources/#{@media_item.source_id}/media/#{@media_item}"}
              method="delete"
              data-confirm="Delete this video's files? It may be downloaded again by the source's rules."
              role="menuitem"
              class={[menu_item_class(), "text-bad"]}
            >
              <.icon name="hero-trash-mini" class="h-4 w-4" /> Delete files
            </.link>
            <.link
              href={~p"/sources/#{@media_item.source_id}/media/#{@media_item}?prevent_download=true"}
              method="delete"
              data-confirm="Delete this video's files and never download it again? This cannot be undone."
              role="menuitem"
              class={[menu_item_class(), "text-bad"]}
            >
              <.icon name="hero-no-symbol-mini" class="h-4 w-4" /> Delete files and don't download again
            </.link>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%!-- Player --%>
<section :if={media_file_exists?(@media_item)} class="pf-card mt-6 overflow-hidden" id="media-player">
  <.media_preview media_item={@media_item} />
</section>

<%!-- Why it's not downloaded --%>
<section
  :if={status_text(@status, @media_item.source.media_profile.name) || @media_item.last_error}
  class={[
    "pf-card mt-6 flex gap-3 px-5 py-4",
    elem(@status, 0) == :failed && "border-bad/40",
    elem(@status, 0) in [:retrying, :off] && "border-warn/40"
  ]}
  id="media-explainer"
>
  <.icon
    name={
      case elem(@status, 0) do
        :failed -> "hero-exclamation-circle"
        :retrying -> "hero-arrow-path"
        :off -> "hero-no-symbol"
        :pending -> "hero-clock"
        _ -> "hero-information-circle"
      end
    }
    class={[
      "mt-0.5 h-5 w-5 shrink-0",
      case elem(@status, 0) do
        :failed -> "text-bad"
        kind when kind in [:retrying, :off] -> "text-warn"
        :pending -> "text-info"
        _ -> "text-muted"
      end
    ]}
  />
  <div class="min-w-0 text-sm">
    <p :if={status_text(@status, @media_item.source.media_profile.name)} class="text-fg">
      {status_text(@status, @media_item.source.media_profile.name)}
      <.link
        :if={skip_owner(@status) == :profile}
        href={~p"/media_profiles/#{@media_item.source.media_profile_id}/edit"}
        class="font-medium text-accent hover:underline"
      >
        Change the profile
      </.link>
      <.link
        :if={skip_owner(@status) == :source}
        href={~p"/sources/#{@media_item.source_id}/edit"}
        class="font-medium text-accent hover:underline"
      >
        Change the source's settings
      </.link>
    </p>
    <div :if={@media_item.last_error} class="mt-2">
      <p class="text-xs font-medium text-muted">Last error</p>
      <p class="mt-0.5 break-words font-mono text-xs text-fg">{@media_item.last_error}</p>
    </div>
  </div>
</section>

<div class="mt-6 grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
  <%!-- Description --%>
  <.card title="Description" class="lg:col-span-2" id="media-description">
    <div class="border-t border-line px-5 py-4 text-sm leading-relaxed text-fg">
      <.render_description :if={@media_item.description not in [nil, ""]} text={@media_item.description} />
      <p :if={@media_item.description in [nil, ""]} class="text-muted">No description.</p>
    </div>
  </.card>

  <%!-- Details --%>
  <.card title="Details" id="media-details">
    <dl class="divide-y divide-line border-t border-line text-sm">
      <div class="flex justify-between gap-4 px-5 py-2.5">
        <dt class="text-muted">Source</dt>
        <dd class="truncate text-right">
          <.link href={~p"/sources/#{@media_item.source_id}"} class="text-accent hover:underline">
            {@media_item.source.custom_name}
          </.link>
        </dd>
      </div>
      <div class="flex justify-between gap-4 px-5 py-2.5">
        <dt class="text-muted">Profile</dt>
        <dd class="truncate text-right">
          <.link href={~p"/media_profiles/#{@media_item.source.media_profile_id}"} class="text-accent hover:underline">
            {@media_item.source.media_profile.name}
          </.link>
        </dd>
      </div>
      <div :if={@media_item.uploaded_at} class="flex justify-between gap-4 px-5 py-2.5">
        <dt class="text-muted">Uploaded</dt>
        <dd class="text-right text-fg"><.datetime_in_zone datetime={@media_item.uploaded_at} format="%Y-%m-%d" /></dd>
      </div>
      <div :if={@media_item.media_downloaded_at} class="flex justify-between gap-4 px-5 py-2.5">
        <dt class="text-muted">Downloaded</dt>
        <dd class="text-right text-fg">{time_ago(@media_item.media_downloaded_at)}</dd>
      </div>
      <div :if={@media_item.media_redownloaded_at} class="flex justify-between gap-4 px-5 py-2.5">
        <dt class="text-muted">Downloaded again</dt>
        <dd class="text-right text-fg">{time_ago(@media_item.media_redownloaded_at)}</dd>
      </div>
      <div class="flex justify-between gap-4 px-5 py-2.5">
        <dt class="text-muted">YouTube ID</dt>
        <dd class="truncate text-right font-mono text-xs text-fg">{@media_item.media_id}</dd>
      </div>
      <div
        :if={@media_item.playlist_index && @media_item.playlist_index > 0}
        class="flex justify-between gap-4 px-5 py-2.5"
      >
        <dt class="text-muted">Playlist position</dt>
        <dd class="text-right text-fg">{@media_item.playlist_index}</dd>
      </div>
    </dl>
    <div :if={files(@media_item) != []} class="border-t border-line px-5 py-3" id="media-files">
      <p class="mb-1.5 text-xs font-medium text-muted">Files</p>
      <ul class="flex flex-col gap-1.5">
        <li :for={{label, path} <- files(@media_item)} class="min-w-0">
          <span class="text-xs text-muted">{label}</span>
          <span class="block truncate font-mono text-xs text-fg" title={path}>{Path.basename(path)}</span>
        </li>
      </ul>
    </div>
  </.card>
</div>

<%!-- The two per-video switches. Each saves as soon as it's flipped. --%>
<.card title="This video" class="mt-6" id="media-switches">
  <.form
    for={to_form(%{}, as: :media_item)}
    action={~p"/sources/#{@media_item.source_id}/media/#{@media_item}"}
    method="patch"
    x-data
    x-on:change="$el.submit()"
    id="prevent-download-form"
  >
    <.settings_row
      label="Download automatically"
      for="media_item_download_auto"
      help="When off, Pinchfork leaves this video alone. Download now still works."
    >
      <%!-- Checked means prevent_download is false, so the hidden fallback says true --%>
      <.media_switch
        id="media_item_download_auto"
        name="media_item[prevent_download]"
        on_value="false"
        off_value="true"
        checked={!@media_item.prevent_download}
      />
    </.settings_row>
  </.form>
  <.form
    for={to_form(%{}, as: :media_item)}
    action={~p"/sources/#{@media_item.source_id}/media/#{@media_item}"}
    method="patch"
    x-data
    x-on:change="$el.submit()"
    id="prevent-culling-form"
  >
    <.settings_row
      label="Keep when cleaning up"
      for="media_item_prevent_culling"
      help={
        if @media_item.source.retention_period_days,
          do:
            "This source deletes downloads after #{@media_item.source.retention_period_days} days. Turn on to keep this one.",
          else: "This source keeps downloads forever, so this only matters if that changes."
      }
    >
      <.media_switch
        id="media_item_prevent_culling"
        name="media_item[prevent_culling]"
        on_value="true"
        off_value="false"
        checked={@media_item.prevent_culling}
      />
    </.settings_row>
  </.form>
</.card>

<%!-- Background jobs for this video --%>
<.card :if={@jobs != []} title="Background jobs" class="mt-6" id="media-jobs">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-t border-line text-left text-xs font-medium uppercase tracking-wide text-muted">
        <th class="px-5 py-2 font-medium">Job</th>
        <th class="px-3 py-2 font-medium">State</th>
        <th class="px-5 py-2 font-medium">Scheduled</th>
      </tr>
    </thead>
    <tbody>
      <tr :for={task <- @jobs} class="border-t border-line">
        <td class="px-5 py-2.5 text-fg">{job_label(task.job.worker)}</td>
        <td class="px-3 py-2.5">
          <.status_chip kind={job_state_kind(task.job.state)}>{job_state_label(task.job.state)}</.status_chip>
        </td>
        <td class="px-5 py-2.5 text-muted"><.datetime_in_zone datetime={task.job.scheduled_at} /></td>
      </tr>
    </tbody>
  </table>
</.card>
