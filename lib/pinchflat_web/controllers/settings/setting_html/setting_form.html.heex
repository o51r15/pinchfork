<.simple_form :let={f} for={@changeset} action={@action}>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>

  <.tabbed_layout>
    <:tab title="General" id="general">
      <section class="mt-4">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-2xl text-black dark:text-white">Extractor Settings</h3>
          <.link href="https://github.com/o51r15/pinchfork/wiki" target="_blank" class="text-sm hover:underline">
            📖 Docs
          </.link>
        </div>

        {live_render(
          @conn,
          Pinchflat.Settings.YoutubeApiKeyLive,
          session: %{"value" => f[:youtube_api_key].value}
        )}

        <.input
          field={f[:extractor_sleep_interval_seconds]}
          placeholder="0"
          type="number"
          label="Sleep Interval (seconds)"
        />

        <.input field={f[:download_throughput_limit]} placeholder="4.2M" label="Download Throughput" />

        <.input field={f[:restrict_filenames]} type="toggle" label="Restrict Filenames" />
      </section>
    </:tab>

    <:tab title="Notifications" id="notifications">
      <section class="mt-4">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-2xl text-black dark:text-white">Notification Settings</h3>
          <.link
            href="https://github.com/o51r15/pinchfork/wiki/Podcast-RSS-Feeds"
            target="_blank"
            class="text-sm hover:underline"
          >
            📖 Docs
          </.link>
        </div>

        {live_render(
          @conn,
          Pinchflat.Settings.AppriseServerLive,
          session: %{"value" => f[:apprise_server].value}
        )}
      </section>
    </:tab>

    <:tab title="Discovery" id="discovery">
      <section class="mt-4">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-2xl text-black dark:text-white">Discovery</h3>
        </div>
        <p class="text-sm text-gray-400 mb-4">
          Find new YouTube channels based on your existing library.
          Scans are manual — hit "Scan Now" on the Discovery page.
        </p>

        <.input field={f[:discovery_enabled]} type="toggle" label="Enable Discovery" />

        <div class="mt-6 mb-2">
          <h4 class="text-lg text-black dark:text-white mb-2">Generators</h4>
          <p class="text-sm text-gray-400 mb-4">
            Toggle which discovery methods are active during a scan.
          </p>
        </div>

        <.input field={f[:discovery_g1_enabled]} type="toggle" label="G1 — Mention Mining" />
        <p class="text-xs text-bodydark2 mb-3 ml-1">
          Finds channels mentioned in your video descriptions. Local only, no network calls.
        </p>

        <.input field={f[:discovery_g2_enabled]} type="toggle" label="G2 — Featured Channels" />
        <p class="text-xs text-bodydark2 mb-3 ml-1">
          Crawls the Channels tab of your sources. Uses yt-dlp, zero API quota.
        </p>

        <.input field={f[:discovery_g3_enabled]} type="toggle" label="G3 — LLM Search (coming soon)" />
        <p class="text-xs text-bodydark2 mb-3 ml-1">
          LLM-guided YouTube search queries. Requires OpenWebUI connection.
        </p>

        <.input field={f[:discovery_g4_enabled]} type="toggle" label="G4 — LLM Suggestions (coming soon)" />
        <p class="text-xs text-bodydark2 mb-3 ml-1">
          Direct channel suggestions from an LLM. Validated before surfacing.
        </p>

        {live_render(@conn, Pinchflat.Settings.DismissedChannelsLive, session: %{})}
      </section>
    </:tab>

    <:tab title="Advanced" id="advanced">
      <section class="mt-4">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-2xl text-black dark:text-white">Codec Options</h3>
          <.link href="https://github.com/o51r15/pinchfork/wiki" target="_blank" class="text-sm hover:underline">
            📖 Docs
          </.link>
        </div>

        <p class="text-sm text-gray-400 mb-4">
          The best available codec will be used if your preferred codecs are not found.
        </p>

        <.input
          field={f[:video_codec_preference]}
          placeholder="avc"
          type="text"
          label="Video Codec Preference"
          inputclass="font-mono text-sm mr-4"
        />

        <.input
          field={f[:audio_codec_preference]}
          placeholder="m4a"
          type="text"
          label="Audio Codec Preference"
          inputclass="font-mono text-sm mr-4"
        />
      </section>
    </:tab>
  </.tabbed_layout>

  <.button class="mt-10 mb-4 sm:mb-8 w-full sm:w-auto" rounding="rounded-lg">Save Settings</.button>
</.simple_form>
