<.page_header
  title="Activity"
  description="What Pinchfork is doing now, what's waiting, and what went wrong. Running updates live; use the refresh button on the other tabs."
/>

<.card>
  <div class="px-5 pt-1 pb-5">
    <.tabbed_layout>
      <:tab title="Running" id="active-tasks" count={@counts.running}>
        {live_render(@conn, Pinchflat.Pages.JobTableLive)}
      </:tab>
      <:tab title="Queued" id="pending" count={@counts.pending}>
        {live_render(@conn, Pinchflat.Pages.HistoryTableLive, session: %{"media_state" => "pending"})}
      </:tab>
      <:tab title="Retrying" id="retry" count={@counts.retry}>
        {live_render(@conn, Pinchflat.Pages.HistoryTableLive, session: %{"media_state" => "retry"})}
      </:tab>
      <:tab title="Failed" id="failed" count={@counts.failed}>
        {live_render(@conn, Pinchflat.Pages.HistoryTableLive, session: %{"media_state" => "failed"})}
      </:tab>
      <:tab title="Downloaded" id="downloaded">
        {live_render(@conn, Pinchflat.Pages.HistoryTableLive, session: %{"media_state" => "downloaded"})}
      </:tab>
    </.tabbed_layout>
  </div>
</.card>
