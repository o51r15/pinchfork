<div class="mx-auto max-w-4xl">
  <.page_header
    title="Backup"
    description="A copy of Pinchfork's database: sources, profiles, settings and the index of every video. Your downloaded files aren't included."
  >
    <:actions>
      <.link
        navigate={~p"/system/backup/upload"}
        class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-line px-3.5 text-sm font-semibold text-fg hover:bg-surface-2"
        id="upload-backup"
      >
        <.icon name="hero-arrow-up-tray-mini" class="h-4 w-4" /> Upload a backup
      </.link>
      <form
        action={~p"/system/backup"}
        method="post"
        x-data="{ busy: false }"
        x-on:submit="busy = true"
        id="backup-now-form"
      >
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <button
          type="submit"
          disabled={@dir_status != :ok}
          x-bind:disabled={"busy || #{@dir_status != :ok}"}
          class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-accent px-3.5 text-sm font-semibold text-onaccent hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <.icon name="hero-archive-box-arrow-down-mini" class="h-4 w-4" x-bind:class="busy && 'animate-pulse'" />
          <span x-text="busy ? 'Backing up…' : 'Back up now'">Back up now</span>
        </button>
      </form>
    </:actions>
  </.page_header>

  <%!-- Where backups go, and whether that's safe --%>
  <div
    :if={@dir_status != :ok or @mounted == false}
    class={[
      "pf-card mb-6 flex gap-3 px-5 py-4",
      if(@dir_status != :ok, do: "border-bad/40", else: "border-warn/40")
    ]}
    id="backup-dir-warning"
  >
    <.icon
      name="hero-exclamation-triangle"
      class={["mt-0.5 h-5 w-5 shrink-0", if(@dir_status != :ok, do: "text-bad", else: "text-warn")]}
    />
    <div class="text-sm text-fg">
      <p :if={@dir_status == :missing}>
        There's no <code class="font-mono text-[13px]">{@backup_dir}</code> folder, so backups can't be made.
      </p>
      <p :if={@dir_status == :read_only}>
        Pinchfork can't write to <code class="font-mono text-[13px]">{@backup_dir}</code>, so backups can't be made.
        Check the folder's permissions on the host.
      </p>
      <p :if={@dir_status == :ok}>
        <code class="font-mono text-[13px]">{@backup_dir}</code>
        is inside the container, so backups are lost when the container is recreated (for example when you update).
      </p>
      <p :if={@dir_status != :read_only} class="mt-1 text-muted">
        Map it to a folder on the host in your compose file, under the Pinchfork service's volumes:
      </p>
      <div :if={@dir_status != :read_only} class="mt-2">
        <.command_block id="backup-volume-line" commands={["- /path/to/backups:#{@backup_dir}"]} />
      </div>
    </div>
  </div>

  <%!-- Summary --%>
  <div :if={@backups != []} class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-3" id="backup-summary">
    <.stat label="Last backup" value={time_ago(hd(@backups).created_at)} />
    <.stat label="Kept" value={"#{length(@backups)} of #{@max_backups}"} />
    <.stat label="Space used" value={total_size(@backups)} />
  </div>

  <%!-- The backups --%>
  <.card
    title="Backups"
    description={"The newest #{@max_backups} are kept; older ones are deleted when a new backup is made."}
    id="backup-list"
  >
    <div :if={@backups == []} class="border-t border-line">
      <.empty_state
        icon="hero-archive-box"
        title="No backups yet"
        description="Back up before updating or changing anything big. Most take a few seconds; a very large library can take a minute."
      />
    </div>
    <ul :if={@backups != []} class="divide-y divide-line border-t border-line">
      <li :for={backup <- @backups} class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-3">
        <.icon name="hero-circle-stack" class="h-5 w-5 shrink-0 text-muted" />
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-fg">
            {Calendar.strftime(backup.created_at, "%b %-d, %Y at %H:%M")} UTC
            <span class="font-normal text-muted">· {time_ago(backup.created_at)}</span>
          </p>
          <p class="truncate font-mono text-xs text-muted">{backup.filename} · {human_bytes(backup.size_bytes)}</p>
        </div>
        <div class="flex items-center gap-2">
          <.link
            href={~p"/system/backup/#{backup.filename}/download"}
            class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-line px-3 text-[13px] font-semibold text-fg hover:bg-surface-2"
          >
            <.icon name="hero-arrow-down-tray-mini" class="h-4 w-4" /> Download
          </.link>
          <.link
            navigate={~p"/system/backup/#{backup.filename}/restore"}
            class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-line px-3 text-[13px] font-semibold text-fg hover:bg-surface-2"
          >
            <.icon name="hero-arrow-uturn-left-mini" class="h-4 w-4" /> Restore
          </.link>
          <.link
            href={~p"/system/backup/#{backup.filename}"}
            method="delete"
            data-confirm="Delete this backup? This cannot be undone."
            class="inline-flex h-8 items-center rounded-lg px-3 text-[13px] font-semibold text-bad hover:bg-bad/10"
          >
            Delete
          </.link>
        </div>
      </li>
    </ul>
  </.card>

  <%!-- Restoring --%>
  <.card
    title="Restoring a backup"
    description="Use Restore next to a backup: it makes a safety backup first and changes nothing if it fails. If Pinchfork won't start at all, you can restore by hand."
    class="mt-6"
    id="backup-restore"
  >
    <div class="flex flex-col gap-3 border-t border-line px-5 py-4 text-sm text-fg">
      <p>
        To restore by hand: on the host, in the folder that holds your backups, run these one at a time. They use the container
        names from the sample compose file (<code class="font-mono text-[13px]">pinchfork</code> and <code class="font-mono text-[13px]">pinchfork-db</code>); change them if yours differ, and put your backup's file name in the third line.
      </p>
      <.command_block
        id="restore-commands"
        commands={[
          "docker stop pinchfork",
          ~s(docker exec -i pinchfork-db psql -U pinchflat -d postgres -c "DROP DATABASE pinchflat;" -c "CREATE DATABASE pinchflat;"),
          "gunzip -c #{if @backups != [], do: hd(@backups).filename, else: "pinchfork-backup-DATE.sql.gz"} | docker exec -i pinchfork-db psql -q -U pinchflat -d pinchflat",
          "docker start pinchfork"
        ]}
      />
      <p class="text-muted">
        Pinchfork goes back to where things stood when the backup was made. Files downloaded after that stay on disk,
        but the database doesn't know about them, so Pinchfork may download those videos again.
      </p>
    </div>
  </.card>
</div>
