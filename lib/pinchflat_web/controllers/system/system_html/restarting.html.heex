<%!-- Shown right after a restore. Pinchfork restarts a few seconds later; this page watches the
     health check, and once it has gone away and come back (or after ~20 seconds of answering)
     moves on to the Backup page. --%>
<div
  class="mx-auto max-w-xl"
  id="restarting"
  x-data={"{ target: #{Jason.encode!(@target)}, health: #{Jason.encode!(~p"/healthcheck")}, down: false, tries: 0 }"}
  x-init="
    const poll = async () => {
      tries++
      try {
        const r = await fetch(health, { cache: 'no-store' })
        if (r.ok && (down || tries > 12)) { window.location = target; return }
        if (!r.ok) down = true
      } catch (e) { down = true }
      setTimeout(poll, 1500)
    }
    setTimeout(poll, 1500)
  "
>
  <div class="pf-card mt-10 flex flex-col items-center gap-3 px-6 py-12 text-center">
    <span class="grid h-12 w-12 place-items-center rounded-full bg-accent-soft">
      <.icon name="hero-arrow-path" class="h-6 w-6 animate-spin text-accent" />
    </span>
    <h1 class="text-lg font-semibold text-fg">Restored. Pinchfork is restarting</h1>
    <p class="max-w-md text-sm text-muted">
      This takes about half a minute. The page moves on by itself when Pinchfork is back. You may need to sign in again.
    </p>
    <p :if={@warning != ""} class="max-w-md text-sm text-warn" id="restarting-warning">{@warning}</p>
    <a href={@target} class="mt-2 text-sm font-medium text-accent hover:underline">
      Go to the Backup page now
    </a>
  </div>
</div>
