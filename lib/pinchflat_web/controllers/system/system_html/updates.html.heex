<div class="mx-auto max-w-4xl">
  <.page_header
    title="Updates"
    description="Pinchfork updates by pulling a new Docker image. yt-dlp keeps itself current."
  />

  <.card title="Installed" id="updates-installed">
    <dl class="divide-y divide-line border-t border-line text-sm">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 py-3">
        <dt class="text-muted">Pinchfork</dt>
        <dd class="font-mono text-fg">v{@current_version}</dd>
      </div>
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 py-3">
        <dt class="text-muted">yt-dlp</dt>
        <dd class="text-right">
          <span class="font-mono text-fg">{@yt_dlp_version || "Not checked yet"}</span>
          <span class="block text-xs text-muted">{yt_dlp_policy_text(@yt_dlp_policy)}</span>
        </dd>
      </div>
    </dl>
  </.card>

  <.card title="Updating Pinchfork" class="mt-6" id="updates-how">
    <:actions>
      <.link
        href="https://github.com/o51r15/pinchfork/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-[13px] font-medium text-muted hover:text-fg"
      >
        What's new <.icon name="hero-arrow-top-right-on-square-mini" class="h-3.5 w-3.5" />
      </.link>
    </:actions>
    <ol class="flex flex-col gap-5 border-t border-line px-5 py-4 text-sm text-fg">
      <li class="flex gap-3">
        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
          1
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-medium">Back up first</p>
          <p class="mt-0.5 text-muted" id="updates-last-backup">
            <%= if @last_backup do %>
              Your last backup was {time_ago(@last_backup.created_at)}.
            <% else %>
              You don't have a backup yet.
            <% end %>
            <.link href={~p"/system/backup"} class="font-medium text-accent hover:underline">Go to Backup</.link>
          </p>
        </div>
      </li>
      <li class="flex gap-3">
        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
          2
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-medium">Pull the new image and restart</p>
          <p class="mb-2 mt-0.5 text-muted">On the host, in the folder with your compose file:</p>
          <.command_block id="update-commands" commands={["docker compose pull", "docker compose up -d"]} />
        </div>
      </li>
      <li class="flex gap-3">
        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
          3
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-medium">Check it's back</p>
          <p class="mt-0.5 text-muted">
            Reload this page and check the version above changed, then glance at <.link
              href={~p"/system/status"}
              class="font-medium text-accent hover:underline"
            >Status</.link>.
            Your sources, settings and downloads are kept: they live in the database and your mapped folders, not in the image.
          </p>
        </div>
      </li>
    </ol>
  </.card>
</div>
